generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Tenancy / usuários
// ============================================================

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  numbers       WhatsAppNumber[]
  contacts      Contact[]
  conversations Conversation[]
  tags          Tag[]
  folders       QuickReplyFolder[]
  subscription  Subscription?
  usage         MessageUsage[]
  usageCounters UsageCounter[]
  invoices      Invoice[]
  alerts        UsageAlert[]

  @@map("tenants")
}

enum Role {
  super_admin
  tenant_admin
  agent
}

model User {
  id           String    @id @default(uuid())
  tenantId     String?   // null = super_admin (dono do Atendo)
  email        String    @unique
  name         String
  passwordHash String
  role         Role
  isActive     Boolean   @default(true)
  totpSecret   String?   // 2FA opcional (criptografado)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant        Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  assigned      Conversation[] @relation("assignee")
  messages      Message[]

  @@index([tenantId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ============================================================
// WhatsApp — números e provider
// ============================================================

enum WhatsAppProvider {
  meta
  evolution
}

enum NumberStatus {
  connected
  pending_qr
  disconnected
  error
}

model WhatsAppNumber {
  id       String           @id @default(uuid())
  tenantId String
  phone    String // E.164
  label    String
  /// A troca oficial <-> não-oficial é somente este campo.
  provider WhatsAppProvider @default(evolution)
  /// Identificador do número dentro do provider: phone_number_id (Meta) ou instanceName (Evolution)
  externalId     String
  /// Credenciais do provider ativo, criptografadas (AES-256-GCM) pelo CryptoService
  providerConfig String
  status         NumberStatus @default(disconnected)
  /// Rateio de infra por mês, usado só no relatório de margem (Evolution)
  infraCostMonth Decimal      @default(0) @db.Decimal(10, 2)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  usage         MessageUsage[]

  @@unique([provider, externalId])
  @@unique([tenantId, phone])
  @@index([tenantId])
  @@map("whatsapp_numbers")
}

// ============================================================
// Contatos / conversas / mensagens
// ============================================================

model Contact {
  id        String   @id @default(uuid())
  tenantId  String
  phone     String // E.164
  name      String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([tenantId, phone])
  @@map("contacts")
}

enum ConversationStatus {
  waiting
  in_progress
  closed
}

enum ConversationOrigin {
  organic
  ad
  post
  link
}

model Conversation {
  id         String             @id @default(uuid())
  tenantId   String
  numberId   String
  contactId  String
  status     ConversationStatus @default(waiting)
  assigneeId String?
  /// De onde o lead veio. `ad` = anúncio (referral do provider). Base do relatório "leads por campanha".
  origin     ConversationOrigin @default(organic)
  /// LeadReferral (packages/shared): id/título do anúncio, ctwa_clid, url
  originData Json?
  /// Última mensagem recebida do contato — define a janela de 24h da Meta
  lastInboundAt  DateTime?
  lastMessageAt  DateTime?
  lastMessagePreview String?
  unreadCount    Int       @default(0)
  closedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number   WhatsAppNumber    @relation(fields: [numberId], references: [id], onDelete: Cascade)
  contact  Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignee User?             @relation("assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages Message[]
  tags     ConversationTag[]

  @@index([tenantId, status, lastMessageAt(sort: Desc)])
  @@index([tenantId, origin])
  @@index([numberId, contactId])
  @@map("conversations")
}

enum MessageDirection {
  in
  out
}

enum MessageType {
  text
  image
  audio
  video
  document
  sticker
  location
  contact
  template
  unknown
}

enum MessageStatus {
  pending
  sent
  delivered
  read
  failed
}

model Message {
  id             String           @id @default(uuid())
  conversationId String
  direction      MessageDirection
  type           MessageType
  status         MessageStatus    @default(pending)
  text           String?
  mediaUrl       String?
  mediaMime      String?
  mediaName      String?
  /// id no provider — usado para idempotência do webhook e status updates
  externalId     String?
  quotedId       String?
  /// atendente que enviou (null = inbound)
  authorId       String?
  error          String?
  raw            Json?
  createdAt      DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  usage        MessageUsage?

  @@unique([externalId])
  @@index([conversationId, createdAt])
  @@map("messages")
}

// ============================================================
// Tags (viram filtros e relatórios)
// ============================================================

model Tag {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  color     String   @default("#6366f1")
  createdAt DateTime @default(now())

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations ConversationTag[]

  @@unique([tenantId, name])
  @@map("tags")
}

model ConversationTag {
  conversationId String
  tagId          String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tag          Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([conversationId, tagId])
  @@index([tagId])
  @@map("conversation_tags")
}

// ============================================================
// Respostas rápidas (painel direito: pastas -> mensagens)
// ============================================================

model QuickReplyFolder {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  replies QuickReply[]

  @@index([tenantId])
  @@map("quick_reply_folders")
}

model QuickReply {
  id       String  @id @default(uuid())
  folderId String
  title    String
  /// suporta variáveis: {{contact.name}}, {{agent.name}}
  body     String
  position Int     @default(0)

  folder QuickReplyFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@index([folderId])
  @@map("quick_replies")
}

// ============================================================
// Planos / assinatura / uso / cobrança
// ============================================================

enum BillingModel {
  fixed
  usage
  hybrid
}

model Plan {
  id           String       @id @default(uuid())
  name         String       @unique
  priceMonth   Decimal      @db.Decimal(10, 2)
  billingModel BillingModel @default(fixed)
  /// PlanLimits (packages/shared) — jsonb para criar planos sem migration
  limits       Json
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  suspended
  canceled
}

model Subscription {
  id                 String             @id @default(uuid())
  tenantId           String             @unique
  planId             String
  status             SubscriptionStatus @default(trialing)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  /// id no gateway (Asaas/Stripe)
  externalId         String?
  graceUntil         DateTime?
  canceledAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

enum BillingCategory {
  service
  utility
  marketing
  authentication
  unofficial
}

/// Tabela de preços do provider por país/categoria. Quando a Meta reajustar, insira nova linha.
model ProviderPricing {
  id        String           @id @default(uuid())
  provider  WhatsAppProvider
  country   String // ISO 3166-1 alpha-2, ex: BR
  category  BillingCategory
  currency  String           @default("BRL")
  unitPrice Decimal          @db.Decimal(10, 5)
  validFrom DateTime
  createdAt DateTime         @default(now())

  @@index([provider, country, category, validFrom(sort: Desc)])
  @@map("provider_pricing")
}

/// Ledger append-only: uma linha por mensagem. Fonte da verdade para cobrança e margem.
model MessageUsage {
  id              String           @id @default(uuid())
  tenantId        String
  numberId        String
  messageId       String           @unique
  provider        WhatsAppProvider
  direction       MessageDirection
  billingCategory BillingCategory
  /// custo do provider estimado no momento do envio
  providerCost    Decimal          @default(0) @db.Decimal(10, 5)
  currency        String           @default("BRL")
  occurredAt      DateTime         @default(now())

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number  WhatsAppNumber @relation(fields: [numberId], references: [id], onDelete: Cascade)
  message Message        @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([tenantId, occurredAt])
  @@index([numberId, occurredAt])
  @@map("message_usage")
}

/// Agregado mensal reconciliado a partir do ledger (Redis é só cache disto).
model UsageCounter {
  id             String   @id @default(uuid())
  tenantId       String
  period         String // YYYY-MM
  messagesSent   Int      @default(0)
  messagesIn     Int      @default(0)
  templatesSent  Int      @default(0)
  providerCost   Decimal  @default(0) @db.Decimal(12, 5)
  overageAmount  Decimal  @default(0) @db.Decimal(12, 2)
  reconciledAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, period])
  @@map("usage_counters")
}

model UsageAlert {
  id        String   @id @default(uuid())
  tenantId  String
  period    String
  threshold Decimal  @db.Decimal(3, 2) // 0.80, 1.00
  metric    String // messages | templates
  sentAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, period, metric, threshold])
  @@map("usage_alerts")
}

enum InvoiceStatus {
  draft
  open
  paid
  failed
  void
}

model Invoice {
  id            String        @id @default(uuid())
  tenantId      String
  period        String
  baseAmount    Decimal       @db.Decimal(12, 2)
  overageAmount Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal       @db.Decimal(12, 2)
  currency      String        @default("BRL")
  status        InvoiceStatus @default(draft)
  externalId    String?
  dueAt         DateTime?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, period])
  @@map("invoices")
}

// ============================================================
// Relatórios dinâmicos (parâmetros salvos -> DSL -> gráfico)
// ============================================================

model SavedReport {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  /// ReportDefinition: métrica, dimensões, filtros (tags, status, número, período), tipo de gráfico
  definition Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("saved_reports")
}
