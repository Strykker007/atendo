# ---- Banco / cache ----
DATABASE_URL=postgresql://atendo:atendo@localhost:5433/atendo?schema=public
REDIS_URL=redis://localhost:6379

# ---- API ----
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=change-me-32-chars-minimum-please
JWT_REFRESH_SECRET=change-me-32-chars-minimum-please-2
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Chave AES-256 (32 bytes, base64) para criptografar credenciais de provider no banco
ENCRYPTION_KEY=

# ---- Evolution API (provider não-oficial) ----
EVOLUTION_BASE_URL=http://localhost:8080
EVOLUTION_API_KEY=change-me-evolution-key

# ---- Meta Cloud API (provider oficial) ----
META_GRAPH_VERSION=v21.0
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=change-me-verify-token

# ---- Web ----
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000

# ---- Storage de mídia ----
# local = disco (grátis, dev). s3 = qualquer S3-compatível (Cloudflare R2, AWS S3, MinIO)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# só para s3:
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# tamanho máximo de upload em MB
MEDIA_MAX_MB=25

# ---- Stripe (cobrança) ----
# Chaves de TESTE (sk_test_…) enquanto não for para produção. Webhook: stripe listen --forward-to localhost:4000/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=brl

# ---- E-mail transacional (Resend). Vazio em dev = e-mails só no log da API ----
RESEND_API_KEY=
MAIL_FROM="Atendo <no-reply@atendo.local>"

# ---- Logs e observabilidade ----
# debug | log | warn | error
LOG_LEVEL=log
# pretty = legível no terminal (dev); json = uma linha JSON por evento (produção/agregador)
LOG_FORMAT=pretty
# Vazio = Sentry desligado. Com DSN, erros 5xx e falhas definitivas de job são enviados com requestId/tenantId
SENTRY_DSN=
# 0 a 1 — amostragem de performance; deixe 0 até precisar
SENTRY_TRACES_SAMPLE_RATE=0
# commit/versão no ar (agrupa erros por release)
APP_VERSION=

# ---- IA (copiloto e bloco de IA nos fluxos) ----
# none = desligada; o front esconde os recursos em vez de dar erro
AI_PROVIDER=none
AI_API_KEY=
# Endpoint alternativo compatível (vazio = o oficial). Destrava Ollama local, Groq,
# OpenRouter e o modo compatível do Gemini. Endpoint local dispensa AI_API_KEY e custa 0.
#   Ollama:  AI_PROVIDER=openai  AI_BASE_URL=http://localhost:11434/v1   AI_MODEL=llama3.2
#   Groq:    AI_PROVIDER=openai  AI_BASE_URL=https://api.groq.com/openai/v1
#   Gemini:  AI_PROVIDER=openai  AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_BASE_URL=
# vazio = modelo padrão do adapter (o mais barato)
AI_MODEL=
AI_MAX_TOKENS=400
# o contato espera no WhatsApp: melhor falhar rápido e cair no humano
AI_TIMEOUT_MS=20000
# converte o preço do fornecedor (USD) para o que você cobra (BRL)
USD_BRL_RATE=5.5
# Preço por 1.000 tokens (USD) para modelo fora da tabela de AI_MODEL_PRICE — use com
# AI_BASE_URL. Vazio = assume o modelo mais caro da tabela (nunca subestimar custo).
AI_PRICE_IN_PER_1K=
AI_PRICE_OUT_PER_1K=
