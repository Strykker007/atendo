generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Tenancy / usuários
// ============================================================

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  /// id do Customer no Stripe (criado no primeiro checkout)
  stripeCustomerId String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  numbers       WhatsAppNumber[]
  contacts      Contact[]
  conversations Conversation[]
  tags          Tag[]
  folders       QuickReplyFolder[]
  subscription  Subscription?
  flows         Flow[]
  professionals Professional[]
  services      Service[]
  appointments  Appointment[]
  schedulingSettings SchedulingSettings?
  usage         MessageUsage[]
  usageCounters UsageCounter[]
  invoices      Invoice[]
  alerts        UsageAlert[]
  aiUsage       AiUsage[]
  settings      TenantSettings?
  businessHours BusinessHour[]
  accessProfiles AccessProfile[]
  campaigns     Campaign[]
  conversationEvents ConversationEvent[]

  @@map("tenants")
}

enum Role {
  super_admin
  tenant_admin
  /// gerente: vê e coordena todos os atendimentos do tenant, gerencia tags/respostas/equipe; não mexe em números nem cobrança
  manager
  agent
}

model User {
  id           String    @id @default(uuid())
  tenantId     String?   // null = super_admin (dono do Atendo)
  email        String    @unique
  name         String
  passwordHash String
  role         Role
  /// perfil de acesso: quando presente, é ELE que decide o que o usuário pode fazer.
  /// Sem perfil, vale o conjunto padrão do `role` (ver packages/shared/permissions.ts).
  profileId    String?
  isActive     Boolean   @default(true)
  totpSecret   String?   // 2FA opcional (criptografado)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant        Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profile       AccessProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  refreshTokens RefreshToken[]
  authTokens    AuthToken[]
  /// convite pendente: usuário existe mas ainda não definiu senha
  invitedAt     DateTime?
  passwordSetAt DateTime?
  assigned      Conversation[] @relation("assignee")
  messages      Message[]
  numbers       UserNumber[]
  events        ConversationEvent[] @relation("eventActor")
  eventsAbout   ConversationEvent[] @relation("eventTarget")

  @@index([tenantId])
  @@index([profileId])
  @@map("users")
}

/// Quais números o usuário opera. **Sem nenhuma linha = opera todos** — é o estado de quem
/// nunca foi restringido, e o padrão para o cliente que tem um número só.
/// Isto é escopo de DADOS, não permissão: "pode configurar números" é diferente de
/// "só atende pelo número da filial Centro".
model UserNumber {
  userId   String
  numberId String

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  number WhatsAppNumber @relation(fields: [numberId], references: [id], onDelete: Cascade)

  @@id([userId, numberId])
  @@index([numberId])
  @@map("user_numbers")
}

/// Conjunto de permissões que o cliente monta. Um enum fechado de papéis não cobre
/// uma farmácia com três gerentes iguais e outra com um "atendente líder" sob medida.
model AccessProfile {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  /// chaves de `Permission` (packages/shared) — lista fechada, validada na API
  permissions String[]
  /// criado junto com o cliente; não pode ser apagado, para o cliente nunca ficar sem perfil
  isSystem    Boolean  @default(false)
  /// perfil padrão que o cliente editou. Enquanto for falso, as permissões acompanham o
  /// catálogo — senão um perfil criado hoje não ganharia as funcionalidades de amanhã.
  customized  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users  User[]

  @@unique([tenantId, name])
  @@map("access_profiles")
}

enum AuthTokenKind {
  reset
  invite
}

/// Tokens de uso único enviados por e-mail (esqueci a senha, convite). Só o hash fica no banco.
model AuthToken {
  id        String        @id @default(uuid())
  userId    String
  kind      AuthTokenKind
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@map("auth_tokens")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// Configurações gerais do cliente. Fuso vive aqui (é do negócio, não de um módulo).
model TenantSettings {
  tenantId String @id
  timezone String @default("America/Sao_Paulo")
  /// desliga o atendimento inteiro sem precisar mexer em horário (feriado, férias)
  attendanceActive Boolean @default(true)
  /// mensagem automática enviada uma vez quando chega mensagem fora do horário
  outsideHoursText String?
  // ---- fluxos padrão do cliente (configurados uma vez, valem para todos os números) ----
  /// primeira mensagem de um contato novo
  welcomeFlowId String?
  /// contato escreve de novo depois de o atendimento ter sido encerrado
  closedFlowId String?
  /// qualquer mensagem que não casou com palavra-chave, após o período de inatividade
  defaultFlowId String?
  defaultFlowInactivityHours Int @default(24)
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

/// Expediente do cliente por dia da semana (0 = domingo). Sem linha = fechado naquele dia.
model BusinessHour {
  id       String @id @default(uuid())
  tenantId String
  weekday  Int
  /// "HH:MM" no fuso do tenant
  start    String
  end      String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, weekday])
  @@map("business_hours")
}

// ============================================================
// WhatsApp — números e provider
// ============================================================

enum WhatsAppProvider {
  meta
  evolution
}

/// Faixas de atraso entre envios. Rajada é o padrão que o WhatsApp pune no não-oficial.
enum SendDelayProfile {
  instant
  fast
  short
  medium
  long
}

enum NumberStatus {
  connected
  pending_qr
  disconnected
  error
}

model WhatsAppNumber {
  id       String           @id @default(uuid())
  tenantId String
  phone    String // E.164
  label    String
  /// A troca oficial <-> não-oficial é somente este campo.
  provider WhatsAppProvider @default(evolution)
  /// Identificador do número dentro do provider: phone_number_id (Meta) ou instanceName (Evolution)
  externalId     String
  /// Credenciais do provider ativo, criptografadas (AES-256-GCM) pelo CryptoService
  providerConfig String
  status         NumberStatus @default(disconnected)
  /// Rateio de infra por mês, usado só no relatório de margem (Evolution)
  infraCostMonth Decimal      @default(0) @db.Decimal(10, 2)
  // ---- proteção contra bloqueio/banimento (só faz sentido no não-oficial) ----
  /// intervalo entre envios deste número; `instant` só para a API oficial
  sendDelay      SendDelayProfile @default(short)
  /// teto de envios por dia. 0 = sem teto (use só na oficial)
  sendDailyLimit Int          @default(1000)
  /// quando o número conectou pela primeira vez — número novo sobe o volume aos poucos
  warmupStartedAt DateTime?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  usage         MessageUsage[]
  users         UserNumber[]
  campaigns     Campaign[]

  @@unique([provider, externalId])
  @@unique([tenantId, phone])
  @@index([tenantId])
  @@map("whatsapp_numbers")
}

// ============================================================
// Contatos / conversas / mensagens
// ============================================================

model Contact {
  id        String   @id @default(uuid())
  tenantId  String
  phone     String // E.164
  name      String?
  /// chave da foto de perfil no NOSSO storage (a URL da CDN do WhatsApp expira)
  avatarUrl String?
  /// última tentativa de buscar a foto — evita uma chamada ao provider por mensagem
  avatarCheckedAt DateTime?
  // ---- ficha do cliente, preenchida pelo atendente ----
  email     String?
  address   String?
  /// observações livres; a 2ª existe porque o documento de funções pediu duas
  note1     String?
  note2     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  tags          ContactTag[]
  appointments  Appointment[]

  /// pediu para não receber disparo. Vale para campanhas; atendimento 1-a-1 continua normal,
  /// porque o contato pode voltar a escrever e precisa ser respondido.
  optOutAt  DateTime?

  campaignTargets CampaignTarget[]

  @@unique([tenantId, phone])
  @@map("contacts")
}

/// Tag "colada" na pessoa: vale para todas as conversas dela (ex.: comprador recorrente).
model ContactTag {
  contactId String
  tagId     String
  createdAt DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@index([tagId])
  @@map("contact_tags")
}

enum ConversationStatus {
  waiting
  in_progress
  closed
}

/// Desfecho do atendimento, registrado no encerramento. Base do relatório de vendas.
enum ConversationOutcome {
  none
  won
  lost
}

enum ConversationOrigin {
  organic
  ad
  post
  link
}

model Conversation {
  id         String             @id @default(uuid())
  tenantId   String
  numberId   String
  contactId  String
  status     ConversationStatus @default(waiting)
  assigneeId String?
  /// De onde o lead veio. `ad` = anúncio (referral do provider). Base do relatório "leads por campanha".
  origin     ConversationOrigin @default(organic)
  /// LeadReferral (packages/shared): id/título do anúncio, ctwa_clid, url
  originData Json?
  /// Última mensagem recebida do contato — define a janela de 24h da Meta
  lastInboundAt  DateTime?
  lastMessageAt  DateTime?
  lastMessagePreview String?
  unreadCount    Int       @default(0)
  closedAt       DateTime?
  // ---- resultado do atendimento (registrado ao encerrar) ----
  outcome        ConversationOutcome @default(none)
  /// valor da venda quando `won`
  outcomeValue   Decimal?  @db.Decimal(12, 2)
  /// motivo quando `lost` — é o que mostra onde se perde negócio
  outcomeReason  String?
  outcomeAt      DateTime?
  outcomeById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number   WhatsAppNumber    @relation(fields: [numberId], references: [id], onDelete: Cascade)
  contact  Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignee User?             @relation("assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages Message[]
  tags     ConversationTag[]
  flowRuns FlowRun[]
  events   ConversationEvent[]
  /// execução de fluxo ativa (para marcar "em automação" na lista)
  activeFlowRunId String?

  @@index([tenantId, status, lastMessageAt(sort: Desc)])
  @@index([tenantId, origin])
  @@index([numberId, contactId])
  aiUsage   AiUsage[]

  @@map("conversations")
}

enum MessageDirection {
  in
  out
}

enum MessageType {
  text
  image
  audio
  video
  document
  sticker
  location
  contact
  template
  unknown
}

enum MessageStatus {
  pending
  sent
  delivered
  read
  failed
}

/// O que aconteceu com o atendimento, em ordem. Ver `ConversationEvent`.
enum ConversationEventType {
  /// atendente assumiu (da fila ou de volta para si)
  claimed
  transferred
  /// devolvido para a fila
  released
  closed
  reopened
}

/// Histórico do atendimento — quem fez o quê e quando.
///
/// A conversa guarda só a foto do momento: dono atual, data do fechamento, último resultado.
/// Isso não responde "quantos atendimentos a Ana fechou em março", e pior: reabrir limpa o
/// desfecho, então o resultado anterior simplesmente deixava de existir.
///
/// Cada encerramento aqui é **um atendimento**. É por isso que a tabela é de eventos e não
/// de campos na conversa: a mesma pessoa volta semanas depois, na mesma conversa, e aquilo é
/// outro atendimento, com outro dono e outro resultado.
///
/// Linha gravada nunca é alterada nem apagada — é registro de auditoria. O desfecho fica
/// copiado no evento de propósito: mesmo que a conversa reabra e perca o dela, o número do
/// mês que já fechou não pode mudar depois.
model ConversationEvent {
  id             String                @id @default(uuid())
  tenantId       String
  conversationId String
  type           ConversationEventType
  /// quem fez. Nulo = sistema (fluxo, automação, encerramento por inatividade)
  actorId        String?
  /// em transferência, quem recebeu
  targetId       String?
  fromStatus     ConversationStatus?
  toStatus       ConversationStatus?
  /// desfecho no encerramento, congelado neste evento
  outcome        ConversationOutcome?
  outcomeValue   Decimal?              @db.Decimal(12, 2)
  /// motivo da perda, ou nota do sistema ("encerrado em massa")
  reason         String?
  createdAt      DateTime              @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("eventActor", fields: [actorId], references: [id], onDelete: SetNull)
  target       User?        @relation("eventTarget", fields: [targetId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  /// base do relatório por atendente e período
  @@index([tenantId, type, createdAt])
  @@index([tenantId, actorId, createdAt])
  @@map("conversation_events")
}

model Message {
  id             String           @id @default(uuid())
  conversationId String
  direction      MessageDirection
  type           MessageType
  status         MessageStatus    @default(pending)
  text           String?
  mediaUrl       String?
  mediaMime      String?
  mediaName      String?
  /// id no provider — usado para idempotência do webhook e status updates
  externalId     String?
  quotedId       String?
  /// atendente que enviou (null = inbound)
  authorId       String?
  /// Nota interna (cadeado): só a equipe vê, nunca vai ao WhatsApp nem conta no uso
  internal       Boolean          @default(false)
  error          String?
  raw            Json?
  createdAt      DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  usage        MessageUsage?

  @@unique([externalId])
  @@index([conversationId, createdAt])
  @@map("messages")
}

// ============================================================
// Tags (viram filtros e relatórios)
// ============================================================

model Tag {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  color     String   @default("#6366f1")
  createdAt DateTime @default(now())

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations ConversationTag[]
  contacts      ContactTag[]

  @@unique([tenantId, name])
  @@map("tags")
}

model ConversationTag {
  conversationId String
  tagId          String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tag          Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([conversationId, tagId])
  @@index([tagId])
  @@map("conversation_tags")
}

// ============================================================
// Respostas rápidas (painel direito: pastas -> mensagens)
// ============================================================

model QuickReplyFolder {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  replies QuickReply[]

  @@index([tenantId])
  @@map("quick_reply_folders")
}

model QuickReply {
  id       String  @id @default(uuid())
  folderId String
  title    String
  /// suporta variáveis: {{contact.name}}, {{agent.name}}. Com mídia, vira a legenda.
  body     String
  // ---- anexo opcional (áudio gravado, foto, catálogo em PDF…) ----
  /// chave no storage; a URL assinada é gerada na hora de usar
  mediaKey  String?
  mediaType String?
  mediaName String?
  mediaMime String?
  position Int     @default(0)

  folder QuickReplyFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@index([folderId])
  @@map("quick_replies")
}

// ============================================================
// Fluxos de automação
// ============================================================

model Flow {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  isActive    Boolean  @default(true)
  /// aparece como atalho na aba Fluxos do chat. Fluxo que roda sozinho (nova conversa,
  /// palavra-chave) não precisa estar lá — vira ruído para quem atende.
  showInChat  Boolean  @default(true)
  /// FlowTrigger (packages/shared)
  trigger     Json
  /// FlowDefinition (packages/shared): nós + arestas
  definition  Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runs   FlowRun[]

  @@index([tenantId])
  @@map("flows")
}

enum FlowRunStatus {
  running
  waiting
  done
  stopped
  failed
}

/// Uma execução de fluxo numa conversa. No máximo uma ativa (running/waiting) por conversa.
model FlowRun {
  id             String        @id @default(uuid())
  tenantId       String
  flowId         String
  conversationId String
  status         FlowRunStatus @default(running)
  currentNodeId  String?
  /// variáveis coletadas (Perguntar) e contexto
  vars           Json          @default("{}")
  /// tentativas inválidas no nó atual (menu/pergunta)
  retries        Int           @default(0)
  waitUntil      DateTime?
  startedById    String?
  error          String?
  startedAt      DateTime      @default(now())
  endedAt        DateTime?

  flow         Flow         @relation(fields: [flowId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, status])
  @@index([flowId, startedAt])
  @@map("flow_runs")
}

// ============================================================
// Agendamento (barbearias, salões, clínicas…)
// ============================================================

/// Preferências de agenda do tenant (uma linha por tenant, criada sob demanda)
model SchedulingSettings {
  tenantId String @id
  /// granularidade dos horários oferecidos (min)
  slotMinutes Int @default(30)
  /// lembretes ao cliente, em minutos antes (ex.: [1440, 60] = véspera e 1 h antes)
  clientReminderMinutes Json @default("[1440, 60]")
  /// aviso ao profissional, minutos antes
  proReminderMinutes Int @default(15)
  /// número do WhatsApp que envia lembretes (null = primeiro conectado)
  numberId String?
  /// quantos dias à frente o robô oferece horários
  daysAhead Int @default(7)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("scheduling_settings")
}

/// Profissional que atende (barbeiro). Recebe o aviso do próximo cliente no WhatsApp dele.
model Professional {
  id       String  @id @default(uuid())
  tenantId String
  name     String
  /// WhatsApp do profissional (E.164), para o aviso "próximo cliente"
  phone    String?
  /// usuário do Atendo correspondente (opcional)
  userId   String?
  color    String  @default("#2f5bea")
  isActive Boolean @default(true)
  createdAt DateTime @default(now())

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hours        WorkingHours[]
  appointments Appointment[]

  @@index([tenantId])
  @@map("professionals")
}

/// Intervalos de trabalho por dia da semana (0 = domingo). Vários por dia = pausas entre eles.
model WorkingHours {
  id             String @id @default(uuid())
  professionalId String
  weekday        Int
  /// "HH:MM"
  start          String
  end            String

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId, weekday])
  @@map("working_hours")
}

model Service {
  id          String  @id @default(uuid())
  tenantId    String
  name        String
  durationMin Int
  price       Decimal @default(0) @db.Decimal(10, 2)
  isActive    Boolean @default(true)
  position    Int     @default(0)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([tenantId])
  @@map("services")
}

enum AppointmentStatus {
  scheduled
  confirmed
  done
  no_show
  canceled
}

enum AppointmentSource {
  flow
  panel
  agenda
}

model Appointment {
  id             String            @id @default(uuid())
  tenantId       String
  professionalId String
  serviceId      String
  contactId      String
  conversationId String?
  startAt        DateTime
  endAt          DateTime
  status         AppointmentStatus @default(scheduled)
  source         AppointmentSource @default(panel)
  notes          String?
  /// lembretes já enviados (minutos-antes que já dispararam), ex.: [1440]
  clientRemindersSent Json      @default("[]")
  proReminderSentAt   DateTime?
  /// cliente respondeu "2 – remarcar" ao lembrete
  rescheduleRequested Boolean   @default(false)
  createdById    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id])
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([tenantId, startAt])
  @@index([professionalId, startAt])
  @@index([contactId, startAt])
  @@map("appointments")
}

// ============================================================
// Planos / assinatura / uso / cobrança
// ============================================================

enum BillingModel {
  fixed
  usage
  hybrid
}

model Plan {
  id           String       @id @default(uuid())
  name         String       @unique
  priceMonth   Decimal      @db.Decimal(10, 2)
  billingModel BillingModel @default(fixed)
  /// PlanLimits (packages/shared) — jsonb para criar planos sem migration
  limits       Json
  /// Price recorrente no Stripe (price_…). Criado por `pnpm stripe:sync`.
  stripePriceId String?     @unique
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  suspended
  canceled
}

model Subscription {
  id                 String             @id @default(uuid())
  tenantId           String             @unique
  planId             String
  status             SubscriptionStatus @default(trialing)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  /// id da Subscription no Stripe (sub_…)
  externalId         String?   @unique
  /// avisa que o cliente pediu cancelamento ao fim do período
  cancelAtPeriodEnd  Boolean   @default(false)
  graceUntil         DateTime?
  canceledAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

enum BillingCategory {
  service
  utility
  marketing
  authentication
  unofficial
}

enum AiTaskKind {
  flow_answer
  flow_classify
  suggest
  rewrite
  summary
}

/// Ledger append-only de IA: uma linha por chamada ao modelo. Fonte da verdade da margem
/// e do teto de gasto — sem isto não dá para saber se a IA está dando lucro ou prejuízo.
model AiUsage {
  id             String     @id @default(uuid())
  tenantId       String
  conversationId String?
  /// atendente que pediu (copiloto); vazio quando foi o robô
  userId         String?
  kind           AiTaskKind
  provider       String
  model          String
  tokensIn       Int        @default(0)
  tokensOut      Int        @default(0)
  /// custo calculado no momento da chamada, com a tabela vigente
  costUsd        Decimal    @default(0) @db.Decimal(12, 6)
  costBrl        Decimal    @default(0) @db.Decimal(12, 6)
  latencyMs      Int?
  /// preenchido quando a chamada falhou (a linha fica, para diagnóstico)
  error          String?
  occurredAt     DateTime   @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([tenantId, occurredAt])
  @@map("ai_usage")
}

/// Tabela de preços do provider por país/categoria. Quando a Meta reajustar, insira nova linha.
model ProviderPricing {
  id        String           @id @default(uuid())
  provider  WhatsAppProvider
  country   String // ISO 3166-1 alpha-2, ex: BR
  category  BillingCategory
  currency  String           @default("BRL")
  unitPrice Decimal          @db.Decimal(10, 5)
  validFrom DateTime
  createdAt DateTime         @default(now())

  @@index([provider, country, category, validFrom(sort: Desc)])
  @@map("provider_pricing")
}

/// Ledger append-only: uma linha por mensagem. Fonte da verdade para cobrança e margem.
model MessageUsage {
  id              String           @id @default(uuid())
  tenantId        String
  numberId        String
  messageId       String           @unique
  provider        WhatsAppProvider
  direction       MessageDirection
  billingCategory BillingCategory
  /// custo do provider estimado no momento do envio
  providerCost    Decimal          @default(0) @db.Decimal(10, 5)
  currency        String           @default("BRL")
  occurredAt      DateTime         @default(now())

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number  WhatsAppNumber @relation(fields: [numberId], references: [id], onDelete: Cascade)
  message Message        @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([tenantId, occurredAt])
  @@index([numberId, occurredAt])
  @@map("message_usage")
}

/// Ledger de conversas cobráveis: uma linha por janela de 24h com o mesmo contato no mesmo
/// número. Existe porque "conversa" e "mensagem" são unidades diferentes e o plano escolhe
/// qual limita — mas as duas são sempre registradas.
model ConversationUsage {
  id        String   @id @default(uuid())
  tenantId  String
  numberId  String
  contactId String
  /// início da janela de 24h
  startedAt DateTime @default(now())

  @@index([tenantId, startedAt])
  @@unique([numberId, contactId, startedAt])
  @@map("conversation_usage")
}

/// Agregado mensal reconciliado a partir do ledger (Redis é só cache disto).
model UsageCounter {
  id             String   @id @default(uuid())
  tenantId       String
  period         String // YYYY-MM
  messagesSent   Int      @default(0)
  messagesIn     Int      @default(0)
  templatesSent  Int      @default(0)
  /// janelas de 24h com contatos distintos — a outra unidade cobrável
  conversations  Int      @default(0)
  providerCost   Decimal  @default(0) @db.Decimal(12, 5)
  overageAmount  Decimal  @default(0) @db.Decimal(12, 2)
  reconciledAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, period])
  @@map("usage_counters")
}

model UsageAlert {
  id        String   @id @default(uuid())
  tenantId  String
  period    String
  threshold Decimal  @db.Decimal(3, 2) // 0.80, 1.00
  metric    String // messages | templates
  sentAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, period, metric, threshold])
  @@map("usage_alerts")
}

enum InvoiceStatus {
  draft
  open
  paid
  failed
  void
}

model Invoice {
  id            String        @id @default(uuid())
  tenantId      String
  period        String
  baseAmount    Decimal       @db.Decimal(12, 2)
  overageAmount Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal       @db.Decimal(12, 2)
  currency      String        @default("BRL")
  status        InvoiceStatus @default(draft)
  /// id da Invoice no Stripe (in_…)
  externalId    String?       @unique
  /// link da fatura hospedada no Stripe (para o cliente pagar/baixar)
  hostedUrl     String?
  dueAt         DateTime?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Um ciclo pode ter MAIS DE UMA fatura no Stripe (proration ao trocar de plano, cobrança
  // avulsa). Chavear por período fazia a segunda sobrescrever a primeira e sumir com o
  // histórico do cliente — a identidade é o id da fatura no Stripe (`externalId`).
  @@index([tenantId, period])
  @@map("invoices")
}

// ============================================================
// Relatórios dinâmicos (parâmetros salvos -> DSL -> gráfico)
// ============================================================

model SavedReport {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  /// ReportDefinition: métrica, dimensões, filtros (tags, status, número, período), tipo de gráfico
  definition Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("saved_reports")
}

// ============================================================
// Transmissão (disparo em massa)
// ============================================================

enum CampaignStatus {
  draft
  scheduled
  running
  paused
  done
  canceled
}

enum CampaignTargetStatus {
  pending
  sent
  failed
  /// inelegível (descadastrado, fora da janela de 24h): não vira mensagem
  skipped
}

/// Disparo para uma lista. NÃO envia por conta própria: cria mensagens e as entrega à fila
/// de saída, herdando intervalo entre envios, teto diário e aquecimento do número.
model Campaign {
  id         String         @id @default(uuid())
  tenantId   String
  numberId   String
  name       String
  /// texto da mensagem; aceita {{nome}} e {{primeiro_nome}}
  text       String
  mediaKey   String?
  mediaType  String?
  mediaName  String?
  /// template aprovado (Meta) — obrigatório para falar com quem está fora da janela de 24h
  template   Json?
  status     CampaignStatus @default(draft)
  /// quando começar; null = assim que iniciar
  startAt    DateTime?
  /// só dispara dentro do horário de funcionamento do cliente
  businessHoursOnly Boolean @default(true)
  createdById String?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number  WhatsAppNumber   @relation(fields: [numberId], references: [id], onDelete: Cascade)
  targets CampaignTarget[]

  @@index([tenantId, status])
  @@map("campaigns")
}

/// Um contato dentro de um disparo. A lista é materializada na criação: quem entrou na
/// etiqueta DEPOIS não recebe um disparo que já começou, e o relatório fica estável.
model CampaignTarget {
  id         String               @id @default(uuid())
  campaignId String
  contactId  String
  status     CampaignTargetStatus @default(pending)
  messageId  String?
  error      String?
  sentAt     DateTime?

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@index([campaignId, status])
  @@map("campaign_targets")
}
