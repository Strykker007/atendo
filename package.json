{
  "name": "atendo",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @atendo/api prisma migrate dev",
    "db:generate": "pnpm --filter @atendo/api prisma generate",
    "db:seed": "pnpm --filter @atendo/api prisma db seed",
    "db:studio": "pnpm --filter @atendo/api prisma studio",
    "infra:up": "docker compose -f infra/docker-compose.yml --env-file .env up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml --env-file .env down",
    "infra:logs": "docker compose -f infra/docker-compose.yml --env-file .env logs -f",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "stripe:sync": "pnpm --filter @atendo/api stripe:sync",
    "db:migrate:create": "cd apps/api && sh scripts/create-migration.sh",
    "up": "bash scripts/up.sh",
    "down": "bash scripts/down.sh",
    "logs": "tail -f .logs/api.log"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.0",
    "typescript": "^5.6.0"
  }
}
